# Planned cloud-side website service configuration; not consumed by the static site.
# Create these directories in the Alibaba Cloud instance, outside /data.
# /mnt/workspace persistence must be verified before production.
WEBSITE_DATA_DIR=/mnt/workspace/react-manip-website/data
WEBSITE_SECRETS_DIR=/mnt/workspace/react-manip-website/secrets
WEBSITE_DATABASE=/mnt/workspace/react-manip-website/data/db/website.sqlite3
EVALUATOR_BASE_URL=http://127.0.0.1:8090
WEBSITE_ALLOWED_ORIGIN=https://qlab-ai.org
WEBSITE_JWT_ISSUER=react-manip-website
WEBSITE_JWT_AUDIENCE=react-manip-evaluator
# These are file locations, not key material. Keys must be generated on the cloud host.
WEBSITE_JWT_PRIVATE_KEY_FILE=/mnt/workspace/react-manip-website/secrets/website-private.pem
WEBSITE_CALLBACK_KEY_FILE=/mnt/workspace/react-manip-website/secrets/callback.key
WEBSITE_ENCRYPTION_KEY_FILE=/mnt/workspace/react-manip-website/secrets/encryption-keys.json